 RowBox[{
  RowBox[{
   RowBox[{"hamiltonian", "[", 
    RowBox[{"kx_", ",", "\[Mu]_", ",", "t_", ",", "tp_", ",", "U_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "t"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "kx"}], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"cu1k", "\[ConjugateTranspose]"}], ".", "cu2k"}], "+", 
       RowBox[{
        RowBox[{"cu2k", "\[ConjugateTranspose]"}], ".", "cu3k"}], "+", 
       RowBox[{
        RowBox[{"cu3k", "\[ConjugateTranspose]"}], ".", "cu4k"}], "+", 
       RowBox[{
        RowBox[{"cu4k", "\[ConjugateTranspose]"}], ".", "cu1k"}], "+", 
       RowBox[{
        RowBox[{"cd1k", "\[ConjugateTranspose]"}], ".", "cd2k"}], "+", 
       RowBox[{
        RowBox[{"cd2k", "\[ConjugateTranspose]"}], ".", "cd3k"}], "+", 
