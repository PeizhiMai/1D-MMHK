      RowBox[{"{", 
       RowBox[{"\"\<\[Omega]\>\"", ",", "\"\<k\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"BaseStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FontSize", "\[Rule]", "20"}], ",", 
        RowBox[{"FontFamily", "\[Rule]", "\"\<times New Roman\>\""}]}], 
       "}"}]}], ",", 
     RowBox[{"FrameTicks", "->", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "Automatic", ",", "None"}], "}"}]}]}], 
    "]"}]}], "\n"}]], "Input",
