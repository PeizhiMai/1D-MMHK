               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "\[Beta]"}], "*", 
                 RowBox[{"tvals", "[", 
                  RowBox[{"[", "m", "]"}], "]"}]}], "]"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"\[Omega]", "+", 
               RowBox[{"tvals", "[", 
