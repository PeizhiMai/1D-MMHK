     RowBox[{"(*", 
      RowBox[{"dims", ":", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Nk", ",", "Nw"}], "}"}], " ", "with", " ", "indices", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"k", "-", "index"}], ",", 
          RowBox[{"w", "-", "index"}]}], "}"}]}]}], "*)"}], 
     RowBox[{"kList", " ", 
      RowBox[{"(", 
       RowBox[{"length", " ", "Nk"}], ")"}]}]}], ",", 
    RowBox[{"wList", " ", 
     RowBox[{"(", 
      RowBox[{"length", " ", "Nw"}], ")"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ReGF", "=", 
     RowBox[{"Re", "[", "GFU8", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"If", " ", "your", " ", "ArrayPlot", " ", "uses", " ", 
      RowBox[{"Transpose", "[", "ReGF", "]"}]}], ",", 
     RowBox[{"that", " ", 
      RowBox[{"means", ":", 
       RowBox[{"x", "-", 
        RowBox[{"axis", " ", "is", " ", "\[Omega]", " ", 
         RowBox[{"(", "wList", ")"}]}]}]}]}], ",", 
     RowBox[{"y", "-", 
      RowBox[{"axis", " ", "is", " ", "k", " ", 
       RowBox[{"(", "kList", ")"}], " ", "and", " ", "data", " ", "index", 
       " ", "ordering", " ", "should", " ", "match", " ", "that", " ", 
       RowBox[{"mapping", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "=", 
     RowBox[{"ListInterpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "ReGF", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Min", "[", "wList", "]"}], ",", 
           RowBox[{"Max", "[", "wList", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Min", "[", "kList", "]"}], ",", 
           RowBox[{"Max", "[", "kList", "]"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"preGHeat", "=", 
     RowBox[{"ArrayPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "ReGF", "]"}], ",", 
       RowBox[{"DataRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Min", "[", "kList", "]"}], ",", 
            RowBox[{"Max", "[", "kList", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Min", "[", "wList", "]"}], ",", 
            RowBox[{"Max", "[", "wList", "]"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"ColorFunction", "->", 
        RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}]}], ",", 
       RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Omega]\>\"", ",", "\"\<k\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FontSize", "->", "20"}], ",", 
          RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], "}"}]}], 
       ",", 
       RowBox[{"Axes", "->", "True"}], ",", 
       RowBox[{"FrameTicks", "->", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "Automatic", ",", "None"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"pZero", "=", 
     RowBox[{"ListContourPlot", "[", 
      RowBox[{
       RowBox[{"Reverse", "[", 
        RowBox[{"Transpose", "[", "ReGF", "]"}], "]"}], ",", 
       RowBox[{"DataRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Min", "[", "kList", "]"}], ",", 
            RowBox[{"Max", "[", "kList", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Min", "[", "wList", "]"}], ",", 
            RowBox[{"Max", "[", "wList", "]"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"Contours", "->", 
        RowBox[{"{", "0", "}"}]}], ",", 
       RowBox[{"ContourStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Black"}], "}"}]}], ",", 
       RowBox[{"ContourShading", "->", "None"}], ",", 
       RowBox[{"Frame", "->", "False"}], ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"MaxPlotPoints", "->", "200"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"preGHeat", ",", "pZero", ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ImagePadding", "->", "All"}]}], "]"}], "\n"}]}]], "Input",
