        RowBox[{"contourGraphics", ",", 
         RowBox[{
          RowBox[{"Line", "[", "pts_", "]"}], ":>", "pts"}], ",", 
         "Infinity"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"splitByIm", "[", "line_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vals", ",", "groups", ",", "solids", ",", "dashed"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"vals", "=", 
           RowBox[{"imf", "@@@", "line"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"Im", 
            RowBox[{"(", 
             RowBox[{"k", ",", "\[Omega]"}], ")"}], " ", "\:6cbf", " ", 
            "contour"}], "*)"}], 
          RowBox[{"groups", "=", 
           RowBox[{"SplitBy", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"line", ",", "vals"}], "}"}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ">", "thresh"}], "&"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"solids", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "&"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{"groups", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "2"}], "]"}], "]"}], ">", "thresh"}], 
               "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"dashed", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Line", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "&"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{"groups", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "2"}], "]"}], "]"}], "<=", "thresh"}], 
               "&"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"solids", ",", "dashed"}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"parts", "=", 
       RowBox[{"splitByIm", "/@", "lines"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"solidLines", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"parts", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dashedLines", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"parts", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sequence", "@@", "styleSolid"}], ",", "solidLines"}], 
        RowBox[{"(*", 
         RowBox[{",", 
          RowBox[{"Sequence", "@@", "styleDashed"}], ",", "dashedLines"}], 
         "*)"}], "}"}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "Input",
