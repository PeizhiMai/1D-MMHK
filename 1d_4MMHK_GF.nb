Cell[CellGroupData[{

Cell["Calculate the green function at U = 8", "Chapter",
 CellChangeTimes->{{3.979407149473299*^9, 
  3.979407200271915*^9}},ExpressionUUID->"ae33a407-0e8a-4fb0-b0eb-\
d1b2847b89db"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Nk", " ", "=", " ", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dw", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wmax", " ", "=", " ", "8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nw", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", "*", 
     RowBox[{"(", 
      RowBox[{"wmax", "/", "dw"}], ")"}]}], "+", "1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wList", "=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "wmax"}], ",", "wmax", ",", "dw"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dk", " ", "=", 
   RowBox[{"2", "*", " ", 
    RowBox[{"Pi", "/", "Nk"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kList", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{"2", "*", "Pi"}], ",", "dk"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"U", "=", "8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Mu]", " ", "=", " ", 
   RowBox[{"U", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tp", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GFU8", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"green", "[", 
      RowBox[{
       RowBox[{"kList", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", "\[Mu]", ",", "t", ",", "tp", 
       ",", "U", ",", "\[Beta]", ",", "wList", ",", "\[Eta]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Nk", "+", "1"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97937898660618*^9, 3.979379311838807*^9}, {
   3.9793796885904016`*^9, 3.979379711378173*^9}, {3.9793797601174726`*^9, 
