        RowBox[{"cd3k", "\[ConjugateTranspose]"}], ".", "cd4k"}], "+", 
       RowBox[{
        RowBox[{"cd4k", "\[ConjugateTranspose]"}], ".", "cd1k"}]}], ")"}]}], 
    "-", 
    RowBox[{"t", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", "*", "kx"}], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"cu2k", "\[ConjugateTranspose]"}], ".", "cu1k"}], "+", 
       RowBox[{
        RowBox[{"cu3k", "\[ConjugateTranspose]"}], ".", "cu2k"}], "+", 
       RowBox[{
        RowBox[{"cu4k", "\[ConjugateTranspose]"}], ".", "cu3k"}], "+", 
       RowBox[{
        RowBox[{"cu1k", "\[ConjugateTranspose]"}], ".", "cu4k"}], "+", 
       RowBox[{
        RowBox[{"cd2k", "\[ConjugateTranspose]"}], ".", "cd1k"}], "+", 
       RowBox[{
        RowBox[{"cd3k", "\[ConjugateTranspose]"}], ".", "cd2k"}], "+", 
       RowBox[{
        RowBox[{"cd4k", "\[ConjugateTranspose]"}], ".", "cd3k"}], "+", 
       RowBox[{
        RowBox[{"cd1k", "\[ConjugateTranspose]"}], ".", "cd4k"}]}], ")"}]}], 
    "+", 
    RowBox[{"U", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"cu1k", "\[ConjugateTranspose]"}], ".", "cu1k", ".", 
        RowBox[{"cd1k", "\[ConjugateTranspose]"}], ".", "cd1k"}], "+", 
       RowBox[{
        RowBox[{"cu2k", "\[ConjugateTranspose]"}], ".", "cu2k", ".", 
        RowBox[{"cd2k", "\[ConjugateTranspose]"}], ".", "cd2k"}], "+", 
       RowBox[{
        RowBox[{"cu3k", "\[ConjugateTranspose]"}], ".", "cu3k", ".", 
        RowBox[{"cd3k", "\[ConjugateTranspose]"}], ".", "cd3k"}], "+", 
       RowBox[{
        RowBox[{"cu4k", "\[ConjugateTranspose]"}], ".", "cu4k", ".", 
        RowBox[{"cd4k", "\[ConjugateTranspose]"}], ".", "cd4k"}]}], ")"}]}], 
    "-", 
    RowBox[{"\[Mu]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"cu1k", "\[ConjugateTranspose]"}], ".", "cu1k"}], "+", 
