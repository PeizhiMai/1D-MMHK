               RowBox[{"tvals", "[", 
                RowBox[{"[", "m", "]"}], "]"}], "-", 
               RowBox[{"I", "*", "d"}]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "256"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "256"}], "}"}]}], "]"}], "/", "Z0"}], "/", 
        "4"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
