Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Heat", "=", 
   RowBox[{"ArrayPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"Im", "[", "GF", "]"}], "]"}], ",", 
     RowBox[{"DataRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Min", "[", "kList", "]"}], ",", 
          RowBox[{"Max", "[", "kList", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Min", "[", "wList", "]"}], ",", 
          RowBox[{"Max", "[", "wList", "]"}]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"ColorFunction", "->", 
      RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}]}], ",", 
     RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
     RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
