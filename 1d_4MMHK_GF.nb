        RowBox[{"cd4k", "\[ConjugateTranspose]"}], ".", "cd4k"}]}], 
      ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"green", "[", 
     RowBox[{
     "kx_", ",", "\[Mu]_", ",", "t_", ",", "tp_", ",", "U_", ",", "\[Beta]_", 
      ",", "\[Omega]_", ",", "d_"}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tt", "=", 
